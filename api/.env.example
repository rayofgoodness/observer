PORT=3040
DATABASE_URL=postgres://user:pass@localhost:5434/error_tracker
REDIS_URL=redis://localhost:6381
APP_ENCRYPTION_KEY=change-me-long-random-string
ADMIN_TOKEN=change-me-admin-token
ANTHROPIC_API_KEY=
# Error retention: occurrences + dead error groups older than this are purged
# daily. Defaults: 7 days, 03:00 every day.
ERROR_RETENTION_DAYS=7
ERROR_RETENTION_CRON=0 3 * * *
# Telegram notifications: one platform bot (create via @BotFather). Clients set a
# per-project chat_id in their dashboard. Empty = notifications disabled.
TELEGRAM_BOT_TOKEN=
