{
  "name": "error-tracker-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "kill $(lsof -ti tcp:${PORT:-3040}) 2>/dev/null; nest start --watch",
    "build": "nest build",
    "start:prod": "kill $(lsof -ti tcp:${PORT:-3040}) 2>/dev/null; node dist/main.js",
    "migrate": "bun --env-file=.env node_modules/.bin/knex migrate:latest",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.0",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "protobufjs": "^8.6.6",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
